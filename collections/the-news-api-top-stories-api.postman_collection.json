          "name": "Get Top Stories",
          "request": {
            "name": "Get Top Stories",
            "description": {
              "content": "Retrieve live and historical top stories globally or filtered by keyword, category, country, language, domain, or date. Supports advanced boolean search operators.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "news",
                "top"
              ],
              "host": [
