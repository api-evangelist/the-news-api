                {
                  "disabled": false,
                  "key": "locale",
                  "value": "<string>",
                  "description": "Comma-separated country codes to filter by."
                },
                {
                  "disabled": false,
                  "key": "categories",
                  "value": "<string>",
                  "description": "Comma-separated categories: general, science, sports, business, health, entertainment, tech, politics, food, travel."
                },
